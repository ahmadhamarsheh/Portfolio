{
  "name": "ahmad-hamarsheh-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ahmad Hamarsheh \u2014 Senior Backend Engineer. Bilingual (EN/AR) static portfolio built with Astro, hosted on Cloudflare Pages.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "dev:functions": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV --port 8788",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "cv:pdf": "node scripts/generate-cv-pdf.mjs",
    "check:all": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "fflate": "^0.8.2"
  }
}
