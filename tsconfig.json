{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "functions",
    "node_modules",
    "playwright-report",
    "test-results",
    ".lighthouseci"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./server/*"]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
