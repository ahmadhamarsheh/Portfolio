# Local secrets for `npm run dev:functions` (wrangler pages dev).
# Copy to .dev.vars (git-ignored). NEVER commit real keys.
#
# These Turnstile keys are Cloudflare's official TEST keys: they always pass.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Leave RESEND_API_KEY empty locally: messages are printed to the console instead of emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
ALLOWED_ORIGINS=http://localhost:8788,http://127.0.0.1:8788
