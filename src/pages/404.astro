---
import LinkButton from '@/components/ui/LinkButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';

const en = useTranslations('en');
const ar = useTranslations('ar');
---

<BaseLayout lang="en" title={`404 | ${en('notFound.title')}`} noindex alternates={false}>
  <section class="blueprint border-b border-line">
    <div class="container-page grid gap-12 py-24 md:grid-cols-2">
      <div class="flex flex-col items-start gap-5">
        <p class="kicker">404</p>
        <h1 class="text-4xl font-semibold tracking-[-0.02em]">{en('notFound.title')}</h1>
        <p class="text-lg text-muted">{en('notFound.text')}</p>
        <LinkButton href="/">{en('notFound.home')}</LinkButton>
      </div>
      <div class="flex flex-col items-start gap-5" lang="ar" dir="rtl">
        <p class="kicker">404</p>
        <h2 class="text-4xl font-semibold">{ar('notFound.title')}</h2>
        <p class="text-lg text-muted">{ar('notFound.text')}</p>
        <LinkButton href="/ar/">{ar('notFound.home')}</LinkButton>
      </div>
    </div>
  </section>
</BaseLayout>
