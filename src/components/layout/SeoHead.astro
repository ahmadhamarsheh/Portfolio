---
import { alternatePath, langs, useTranslations, type Lang } from '@/i18n';
import { toJsonLd } from '@/lib/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage: string;
  noindex?: boolean;
  /** Set to false for pages that only exist in one language (e.g. the bilingual 404). */
  alternates?: boolean;
  jsonLd?: unknown;
}

const {
  lang,
  title,
  description,
  ogImage,
  noindex = false,
  alternates = true,
  jsonLd,
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://ahmadhamarsheh.pages.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const otherLocales = langs.filter((l) => l !== lang).map((l) => useTranslations(l)('meta.locale'));
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

{alternates &&
  langs.map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={new URL(alternatePath(Astro.url.pathname, l), site).href}
    />
  ))}
{alternates && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={new URL(alternatePath(Astro.url.pathname, 'en'), site).href}
  />
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Ahmad Hamarsheh" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={t('meta.locale')} />
{otherLocales.map((locale) => (
  <meta property="og:locale:alternate" content={locale} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLd !== undefined && <script type="application/ld+json" set:html={toJsonLd(jsonLd)} />}
