---
import type { CaseStudy } from '@/lib/content';

/**
 * Renders an architecture diagram from data (nodes, edges, numbered markers).
 * One component means every diagram shares the same visual language, follows
 * the light/dark theme, and stays translatable. No exported images to maintain.
 * Data flow always reads left-to-right, so the drawing is LTR in both languages.
 */
interface Props {
  id: string;
  diagram: CaseStudy['diagram'];
  label: string;
}

const { id, diagram, label } = Astro.props;
const titleId = `${id}-title`;
const descId = `${id}-desc`;
const arrowId = `${id}-arrow`;

type Point = readonly [number, number];

/** Pulls the last point back so the line ends under the arrowhead, not past its tip. */
function trimEnd(points: readonly Point[], by: number): Point[] {
  const copy = points.map((p) => [p[0], p[1]] as const);
  const last = copy.at(-1);
  const prev = copy.at(-2);
  if (!last || !prev) return copy;
  const dx = last[0] - prev[0];
  const dy = last[1] - prev[1];
  const length = Math.hypot(dx, dy) || 1;
  copy[copy.length - 1] = [last[0] - (dx / length) * by, last[1] - (dy / length) * by];
  return copy;
}

const toPoints = (points: readonly Point[]) => points.map(([x, y]) => `${x},${y}`).join(' ');
---

<div
  class="blueprint overflow-x-auto bg-bg"
  dir="ltr"
  tabindex="0"
  role="region"
  aria-label={label}
>
  <svg
    viewBox={`0 0 ${diagram.width} ${diagram.height}`}
    width={diagram.width}
    height={diagram.height}
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
    class="mx-auto block h-auto w-full min-w-[720px]"
  >
    <title id={titleId}>{label}</title>
    <desc id={descId}>{diagram.description}</desc>
    <defs>
      <marker
        id={arrowId}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="9"
        markerHeight="9"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z" class="fill-arrow"></path>
      </marker>
    </defs>

    <g
      fill="none"
      class="stroke-arrow"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {diagram.edges.map((edge) => (
        <polyline points={toPoints(trimEnd(edge.points, 4))} marker-end={`url(#${arrowId})`} />
      ))}
    </g>

    {diagram.nodes.map((node) => {
      const cx = node.x + node.w / 2;
      const cy = node.y + node.h / 2;
      return (
        <g>
          <rect
            x={node.x}
            y={node.y}
            width={node.w}
            height={node.h}
            rx="8"
            class={node.highlight ? 'fill-accent-soft stroke-accent' : 'fill-surface stroke-line'}
            stroke-width={node.highlight ? 1.5 : 1}
          />
          <text
            x={cx}
            y={node.sub ? cy - 3 : cy + 5}
            text-anchor="middle"
            font-size="15"
            font-weight="600"
            class="fill-fg"
          >
            {node.label}
          </text>
          {node.sub && (
            <text x={cx} y={cy + 18} text-anchor="middle" font-size="13" class="fill-muted">
              {node.sub}
            </text>
          )}
        </g>
      );
    })}

    {diagram.edges
      .filter((edge) => edge.label && edge.labelAt)
      .map((edge) => (
        <text
          x={edge.labelAt?.[0]}
          y={edge.labelAt?.[1]}
          text-anchor={edge.labelAnchor}
          font-size="13"
          class="fill-muted"
        >
          {edge.label}
        </text>
      ))}

    {diagram.markers.map((marker) => (
      <g aria-hidden="true">
        <circle cx={marker.x} cy={marker.y} r="12" class="fill-accent" />
        <text
          x={marker.x}
          y={marker.y + 4}
          text-anchor="middle"
          font-size="12"
          font-weight="600"
          class="fill-accent-ink font-mono"
        >
          {marker.n}
        </text>
      </g>
    ))}
  </svg>
</div>
