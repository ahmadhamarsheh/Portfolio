---
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import { useTranslations, type Lang } from '@/i18n';
import type { CaseStudy } from '@/lib/content';

/**
 * Problem → My role → Architecture → Key decisions → Result.
 * Shared by the featured case study on the home page and the case study pages.
 */
interface Props {
  lang: Lang;
  cs: CaseStudy;
  /** Heading level for the sub-sections (one below the case study title). */
  sub?: 'h2' | 'h3' | 'h4';
}

const { lang, cs, sub = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Sub = sub;

const facts = [
  { label: t('cs.factRole'), value: cs.facts.role },
  { label: t('cs.factCompany'), value: cs.facts.company },
  { label: t('cs.stack'), value: cs.facts.stack.join(' · ') },
  ...(cs.facts.observability
    ? [{ label: t('cs.factObservability'), value: cs.facts.observability.join(' · ') }]
    : []),
  { label: t('cs.factScope'), value: cs.facts.scope.join(' · ') },
];
---

<div class="mt-12 flex flex-wrap gap-10">
  <aside
    aria-label={t('cs.facts')}
    class="flex min-w-0 flex-[1_1_280px] flex-col gap-4 self-start rounded-[10px] border border-line bg-surface p-[22px] md:max-w-[340px]"
  >
    <dl class="flex flex-col gap-4">
      {facts.map((fact) => (
        <div class="flex flex-col gap-1">
          <dt class="font-mono text-xs text-muted">{fact.label}</dt>
          <dd dir="auto" class="text-[15px] font-semibold rtl:text-right">
            {fact.value}
          </dd>
        </div>
      ))}
    </dl>
  </aside>

  <div class="grid min-w-0 flex-[999_1_560px] content-start gap-x-10 gap-y-8 md:grid-cols-2">
    <div>
      <Sub class="label">{t('cs.problem')}</Sub>
      <p class="mt-3 text-[17px] leading-[1.7]">{cs.problem}</p>
    </div>
    <div>
      <Sub class="label">{t('cs.role')}</Sub>
      <p class="mt-3 text-[17px] leading-[1.7]">{cs.myRole}</p>
    </div>
  </div>
</div>

<figure class="mt-14 overflow-hidden rounded-[10px] border border-line">
  <figcaption class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface px-[18px] py-3.5 text-[13px] text-muted">
    <Sub class="text-sm font-semibold text-fg">{t('cs.architecture')}</Sub>
    <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="inline-flex items-center gap-2">
        <span
          aria-hidden="true"
          class="inline-block h-3 w-3 rounded-[3px] border-[1.5px] border-accent bg-accent-soft"
        ></span>
        {t('cs.legendScope')}
      </span>
      {cs.diagram.markers.length > 0 && (
        <span class="inline-flex items-center gap-2">
          <span aria-hidden="true" class="inline-block h-4 w-4 rounded-full bg-accent" />
          {t('cs.legendDecisions')}
        </span>
      )}
    </span>
  </figcaption>
  <ArchitectureDiagram
    id={`diagram-${cs.key}`}
    diagram={cs.diagram}
    label={`${t('cs.diagramLabel')}: ${cs.title}`}
  />
</figure>

<div class="mt-14 flex flex-wrap gap-10">
  <div class="min-w-0 flex-[999_1_560px]">
    <Sub class="label">{t('cs.decisions')}</Sub>
    <ol class="mt-4 border-t border-line" role="list">
      {cs.decisions.map((decision, i) => (
        <li class="flex gap-4 border-b border-line py-[18px]">
          {decision.marker !== undefined ? (
            <span
              class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent font-mono text-xs font-semibold text-accent-ink"
              aria-hidden="true"
            >
              {decision.marker}
            </span>
          ) : (
            <span
              class="flex h-6 w-6 flex-none items-center justify-center rounded-full border-[1.5px] border-muted font-mono text-xs font-semibold text-muted"
              aria-hidden="true"
            >
              {i + 1}
            </span>
          )}
          <p class="text-base leading-relaxed">
            <strong class="font-semibold">{decision.title}</strong> {decision.text}
          </p>
        </li>
      ))}
    </ol>
  </div>
  <div class="min-w-0 flex-[1_1_300px]">
    <Sub class="label">{t('cs.result')}</Sub>
    <dl class="mt-4 flex flex-col gap-[18px] rounded-[10px] border border-line bg-surface p-[22px]">
      {cs.results.map((result) => (
        <div class="flex flex-col-reverse gap-0.5">
          <dt class="text-sm text-muted">{result.label}</dt>
          <dd class="text-[32px] leading-tight font-semibold tracking-[-0.02em]">{result.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>
