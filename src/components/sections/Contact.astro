---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/config/site';
import { useTranslations, type Lang, type UiKey } from '@/i18n';
import { CONTACT_LIMITS, type ContactErrorCode } from '@/lib/contact/validation';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';

const errorCodes: ContactErrorCode[] = [
  'name.required',
  'name.tooLong',
  'email.invalid',
  'company.tooLong',
  'topic.invalid',
  'message.tooShort',
  'message.tooLong',
];

/** Every message the form script may show, already translated. */
const messages = {
  validation: Object.fromEntries(errorCodes.map((code) => [code, t(`val.${code}` as UiKey)])),
  sending: t('contact.sending'),
  send: t('contact.send'),
  success: t('contact.success'),
  fix: t('contact.error.fix'),
  generic: t('contact.error.generic'),
  rate: t('contact.error.rate'),
  captcha: t('contact.error.captcha'),
};

const inputClass =
  'mt-2 block w-full rounded-md border border-line bg-bg px-3.5 py-3 text-base text-fg placeholder:text-muted transition-colors focus:border-accent focus:outline-none aria-[invalid=true]:border-danger';
const labelClass = 'text-sm font-semibold';
const errorClass = 'mt-1.5 min-h-5 text-sm text-danger';
---

<section id="contact" aria-labelledby="contact-title" class="border-t border-line">
  <div class="container-page py-20 md:py-[104px]">
    <SectionHeading
      id="contact-title"
      kicker={t('contact.kicker')}
      title={t('contact.title')}
      lede={t('contact.lede')}
    />

    <div class="mt-12 flex flex-wrap gap-10">
      <form
        class="min-w-0 flex-[999_1_560px] rounded-[10px] border border-line bg-surface p-6 md:p-8"
        method="post"
        action="/api/contact"
        novalidate
        data-contact-form
        data-lang={lang}
        data-sitekey={siteKey}
        data-messages={JSON.stringify(messages)}
      >
        <div class="grid gap-x-5 gap-y-2 md:grid-cols-2">
          <div>
            <label for="contact-name" class={labelClass}>
              {t('contact.name')}
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength={CONTACT_LIMITS.nameMax}
              aria-describedby="contact-name-error"
              class={inputClass}
            />
            <p id="contact-name-error" class={errorClass} data-error-for="name"></p>
          </div>
          <div>
            <label for="contact-email" class={labelClass}>
              {t('contact.email')}
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength={CONTACT_LIMITS.emailMax}
              dir="ltr"
              aria-describedby="contact-email-error"
              class={inputClass}
            />
            <p id="contact-email-error" class={errorClass} data-error-for="email"></p>
          </div>
          <div>
            <label for="contact-company" class={labelClass}>
              {t('contact.company')}{' '}
              <span class="font-normal text-muted">({t('contact.optional')})</span>
            </label>
            <input
              id="contact-company"
              name="company"
              type="text"
              autocomplete="organization"
              maxlength={CONTACT_LIMITS.companyMax}
              aria-describedby="contact-company-error"
              class={inputClass}
            />
            <p id="contact-company-error" class={errorClass} data-error-for="company"></p>
          </div>
          <div>
            <label for="contact-topic" class={labelClass}>
              {t('contact.topic')}
            </label>
            <select
              id="contact-topic"
              name="topic"
              required
              aria-describedby="contact-topic-error"
              class={inputClass}
            >
              <option value="project">{t('contact.topic.project')}</option>
              <option value="role">{t('contact.topic.role')}</option>
              <option value="other">{t('contact.topic.other')}</option>
            </select>
            <p id="contact-topic-error" class={errorClass} data-error-for="topic"></p>
          </div>
          <div class="md:col-span-2">
            <label for="contact-message" class={labelClass}>
              {t('contact.message')}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              minlength={CONTACT_LIMITS.messageMin}
              maxlength={CONTACT_LIMITS.messageMax}
              aria-describedby="contact-message-error"
              class={inputClass}
            ></textarea>
            <p id="contact-message-error" class={errorClass} data-error-for="message"></p>
          </div>
        </div>

        <!-- Honeypot: invisible to people and assistive tech; bots tend to fill it. -->
        <div class="sr-only" aria-hidden="true">
          <label for="contact-website">{t('contact.honeypot')}</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-4" data-turnstile></div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="inline-flex h-[52px] items-center justify-center gap-2.5 rounded-md bg-accent px-6 text-base font-semibold text-accent-ink transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60"
            data-submit
          >
            {t('contact.send')}
          </button>
          <p role="status" aria-live="polite" class="min-h-6 text-sm" data-status></p>
        </div>
        <noscript>
          <p class="mt-4 text-sm text-muted">
            {t('contact.direct')}:{' '}
            <a class="text-accent underline" href={`mailto:${siteConfig.email}`}>
              {siteConfig.email}
            </a>
          </p>
        </noscript>
      </form>

      <aside class="flex min-w-0 flex-[1_1_320px] flex-col gap-4 self-start rounded-[10px] border border-line p-6">
        <h3 class="label">{t('contact.direct')}</h3>
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center gap-2.5 py-1.5 text-[15px] [overflow-wrap:anywhere] hover:text-accent"
        >
          <Icon name="mail" size={18} class="flex-none text-accent" />
          {siteConfig.email}
        </a>
        <a
          href={siteConfig.linkedin}
          rel="me noopener"
          class="inline-flex items-center gap-2.5 py-1.5 hover:text-accent"
        >
          <Icon name="external" size={18} class="flex-none text-accent" />
          LinkedIn
        </a>
        <a
          href={siteConfig.cvPath}
          download
          hreflang="en"
          class="inline-flex items-center gap-2.5 py-1.5 hover:text-accent"
        >
          <Icon name="download" size={18} class="flex-none text-accent" />
          {t('cta.cv')}
        </a>
      </aside>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '@/scripts/contact-form';
  initContactForm();
</script>
