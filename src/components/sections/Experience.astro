---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ExperienceSteps from './ExperienceSteps.astro';
import { useTranslations, type Lang } from '@/i18n';
import type { Profile } from '@/lib/content';
import {
  formatPeriod,
  isCurrent,
  type ExperienceBlock,
  type ExperienceItem,
  type GrowthStep,
} from '@/lib/experience';

interface Props {
  lang: Lang;
  blocks: ExperienceBlock[];
  growth: GrowthStep[];
  profile: Profile;
}

const { lang, blocks, growth, profile } = Astro.props;
const t = useTranslations(lang);
const present = { range: t('period.range'), since: t('period.since') };
const stageLabel = (stage: ExperienceItem['stage']) =>
  `${String(stage.index).padStart(2, '0')} · ${stage.label}`;
const education = `${profile.education
  .map((e) => `${e.degree}${e.note ? ` (${e.note})` : ''}`)
  .join(' · ')}, ${profile.education[0]?.school ?? ''}`;
---

<section id="experience" aria-labelledby="experience-title" class="border-t border-line bg-surface">
  <div class="container-page py-20 md:py-[104px]">
    <SectionHeading
      id="experience-title"
      kicker={t('exp.kicker')}
      title={t('exp.title')}
      lede={t('exp.lede')}
    />

    <ol
      aria-label={t('exp.growth')}
      class="mt-14 grid gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4"
      role="list"
    >
      {growth.map((step) => (
        <li
          class:list={[
            'relative flex flex-col gap-1.5 border-t-2 pt-[22px]',
            step.current ? 'border-accent' : 'border-line',
          ]}
        >
          <span
            aria-hidden="true"
            class:list={[
              'absolute -top-[7px] start-0 h-3 w-3 rounded-full',
              step.current ? 'bg-accent' : 'border-2 border-muted bg-surface',
            ]}
          />
          <span class:list={['font-mono text-[13px]', step.current ? 'text-accent' : 'text-muted']}>
            {step.year}
            {step.current && ` · ${t('exp.now')}`}
          </span>
          <span class="text-base font-semibold">{step.label}</span>
          <span class="text-sm text-muted">{step.companies.join(' · ')}</span>
        </li>
      ))}
    </ol>

    <ol class="mt-16 border-t border-line" role="list">
      {blocks.map((block) =>
        block.kind === 'single' ? (
          <li class="flex flex-wrap gap-x-10 gap-y-3 border-b border-line py-8">
            <div class="flex flex-[0_0_190px] flex-col items-start gap-2.5">
              <span class="font-mono text-[13px]">
                {formatPeriod(block.item.start, block.item.end, present)}
              </span>
              {isCurrent(block.item) && (
                <span class="rounded bg-accent px-2 py-0.5 font-mono text-xs font-semibold text-accent-ink">
                  {t('exp.current')}
                </span>
              )}
            </div>
            <div class="min-w-0 flex-[1_1_560px]">
              <p class="font-mono text-xs text-accent">{stageLabel(block.item.stage)}</p>
              <h3 class="mt-2 text-[22px] font-semibold tracking-[-0.01em]">
                {block.item.role} · {block.item.company}
              </h3>
              <p class="mt-1 text-sm text-muted">{block.item.context}</p>
              {block.item.summary && (
                <p class="mt-3.5 max-w-[760px] leading-[1.7]">{block.item.summary}</p>
              )}
              {block.item.steps && <ExperienceSteps steps={block.item.steps} />}
              <p dir="auto" class="mt-3.5 font-mono text-[13px] text-muted rtl:text-right">
                {block.item.stack.join(' · ')}
              </p>
            </div>
          </li>
        ) : (
          <li class="flex flex-wrap gap-x-10 gap-y-3 border-b border-line py-8">
            <div class="flex flex-[0_0_190px] flex-col items-start gap-2.5">
              <span class="font-mono text-[13px]">
                {formatPeriod(block.start, block.end, present)}
              </span>
              <span class="text-[13px] text-muted">{block.label}</span>
            </div>
            <div class="min-w-0 flex-[1_1_560px]">
              <p class="font-mono text-xs text-accent">{stageLabel(block.stage)}</p>
              <div class="mt-2 flex flex-col">
                {block.items.map((item, i) => (
                  <div class:list={[i > 0 && 'mt-6 border-t border-dashed border-line pt-6']}>
                    <h3 class="text-[22px] font-semibold tracking-[-0.01em]">
                      {item.role} · {item.company}
                    </h3>
                    <p class="mt-1 text-sm text-muted">
                      {item.context} ·{' '}
                      <span class="font-mono text-[13px]">
                        {formatPeriod(item.start, item.end, present)}
                      </span>
                    </p>
                    {item.summary && (
                      <p class="mt-3.5 max-w-[760px] leading-[1.7]">{item.summary}</p>
                    )}
                    {item.steps && <ExperienceSteps steps={item.steps} />}
                    <p dir="auto" class="mt-4 font-mono text-[13px] text-muted rtl:text-right">
                      {item.stack.join(' · ')}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </li>
        ),
      )}
    </ol>

    <div class="mt-12 flex flex-wrap gap-x-12 gap-y-4 text-[15px] leading-relaxed">
      <p>
        <span class="me-2 font-mono text-xs text-muted">{t('exp.education')}</span>
        {education}
      </p>
      <p>
        <span class="me-2 font-mono text-xs text-muted">{t('exp.certification')}</span>
        {profile.certifications.map((c) => c.name).join(' · ')}
      </p>
    </div>
  </div>
</section>
