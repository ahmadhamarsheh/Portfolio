---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { useTranslations, type Lang } from '@/i18n';
import type { Service } from '@/lib/content';

interface Props {
  lang: Lang;
  services: Service[];
}

const { lang, services } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" aria-labelledby="services-title" class="border-t border-line">
  <div class="container-page py-20 md:py-[104px]">
    <SectionHeading
      id="services-title"
      kicker={t('services.kicker')}
      title={t('services.title')}
      lede={t('services.lede')}
    />

    <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service) => (
        <li class="flex flex-col gap-4 rounded-[10px] border border-line bg-surface p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft text-accent">
            <Icon name={service.icon} size={20} />
          </span>
          <h3 class="text-lg font-semibold">{service.title}</h3>
          <p class="leading-relaxed text-muted">{service.summary}</p>
          <div class="mt-auto border-t border-line pt-4">
            <p class="font-mono text-xs text-muted">{t('services.youGet')}</p>
            <ul class="mt-3 flex flex-col gap-2.5 text-[15px] leading-snug" role="list">
              {service.deliverables.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={16} class="mt-0.5 flex-none text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-10">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 py-2 font-semibold text-accent hover:underline"
      >
        {t('services.cta')}
        <Icon name="arrowRight" size={16} class="flip-rtl" />
      </a>
    </p>
  </div>
</section>
