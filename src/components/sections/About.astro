---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { useTranslations, type Lang } from '@/i18n';
import type { Profile, SkillGroup } from '@/lib/content';

interface Props {
  lang: Lang;
  profile: Profile;
  skills: { strong: SkillGroup[]; working: SkillGroup[] };
}

const { lang, profile, skills } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" aria-labelledby="about-title" class="border-t border-line bg-surface">
  <div class="container-page py-20 md:py-[104px]">
    <SectionHeading id="about-title" kicker={t('about.kicker')} title={t('about.title')} />

    <div class="mt-12 flex flex-wrap gap-x-14 gap-y-12">
      <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-5 text-[17px] leading-[1.75]">
        {profile.about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="min-w-0 flex-[1_1_420px]">
        <h3 class="label">{t('about.greatAt')}</h3>
        <dl class="mt-4 flex flex-col border-t border-line">
          {profile.about.strengths.map((strength) => (
            <div class="border-b border-line py-4">
              <dt class="font-semibold">{strength.title}</dt>
              <dd class="mt-1 leading-relaxed text-muted">{strength.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="mt-16">
      <h3 class="label">{t('skills.title')}</h3>
      <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {skills.strong.map((group) => (
          <div class="rounded-[10px] border border-line bg-bg p-5">
            <p class="flex items-center justify-between gap-3">
              <span class="font-semibold">{group.title}</span>
              <span class="rounded bg-accent-soft px-2 py-0.5 font-mono text-[11px] text-accent">
                {t('skills.strong')}
              </span>
            </p>
            <ul class="mt-3 flex flex-wrap gap-2" role="list">
              {group.items.map((item) => (
                <li dir="auto" class="rounded border border-line px-2 py-1 font-mono text-[13px]">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
        {skills.working.map((group) => (
          <div class="rounded-[10px] border border-dashed border-line p-5">
            <p class="flex items-center justify-between gap-3">
              <span class="font-semibold">{group.title}</span>
              <span class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
                {t('skills.working')}
              </span>
            </p>
            <ul class="mt-3 flex flex-wrap gap-2" role="list">
              {group.items.map((item) => (
                <li
                  dir="auto"
                  class="rounded border border-dashed border-line px-2 py-1 font-mono text-[13px] text-muted"
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted">
        <span class="me-2 font-mono text-xs">{t('about.languages')}</span>
        {profile.languagesSpoken}
      </p>
    </div>
  </div>
</section>
