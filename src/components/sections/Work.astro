---
import CaseStudyBody from '@/components/case-study/CaseStudyBody.astro';
import CaseStudyCard from '@/components/case-study/CaseStudyCard.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { localizePath, useTranslations, type Lang } from '@/i18n';
import type { CaseStudy } from '@/lib/content';

interface Props {
  lang: Lang;
  caseStudies: CaseStudy[];
}

const { lang, caseStudies } = Astro.props;
const t = useTranslations(lang);
const featured = caseStudies.find((cs) => cs.featured) ?? caseStudies[0];
const others = caseStudies.filter((cs) => cs !== featured);
---

<section id="work" aria-labelledby="work-title">
  <div class="container-page py-20 md:py-[104px]">
    <SectionHeading
      id="work-title"
      kicker={t('work.kicker')}
      title={t('work.title')}
      lede={t('work.lede')}
    />

    {featured && (
      <article aria-labelledby={`cs-${featured.key}`} class="mt-16 border-t border-line pt-14">
        <p class="kicker">
          {t('cs.caseStudy')} 01 · {featured.kicker}
        </p>
        <h3
          id={`cs-${featured.key}`}
          class="mt-3.5 max-w-[860px] text-[clamp(1.625rem,3vw,2.5rem)] leading-[1.12] font-semibold tracking-[-0.025em]"
        >
          {featured.title}
        </h3>
        <p class="mt-4 max-w-[760px] text-lg leading-relaxed text-muted">{featured.summary}</p>
        <CaseStudyBody lang={lang} cs={featured} sub="h4" />
        <p class="mt-10">
          <a
            href={localizePath(`/work/${featured.key}/`, lang)}
            class="inline-flex items-center gap-2 py-2 font-semibold text-accent hover:underline"
          >
            {t('work.read')}
            <Icon name="arrowRight" size={16} class="flip-rtl" />
          </a>
        </p>
      </article>
    )}

    {others.length > 0 && (
      <div class="mt-20">
        <h3 class="label">{t('work.more')}</h3>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {others.map((cs) => (
            <CaseStudyCard lang={lang} cs={cs} headingLevel="h4" />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
